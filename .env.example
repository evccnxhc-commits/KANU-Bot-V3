# Required for production sessions. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-secret
# Keep your existing AI provider keys in Render Environment; never commit them here.
GROQ_API_KEY=
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=
NVIDIA_API_KEY=
# Existing Meta Messenger settings (preserve your current values)
VERIFY_TOKEN=
FACEBOOK_APP_SECRET=
PAGE_ACCESS_TOKEN=
GRAPH_API_VERSION=v23.0
# SQLite database path. Render's local filesystem may reset unless a persistent disk is mounted.
DATABASE_PATH=kanu_users.sqlite3
COOKIE_SECURE=true
